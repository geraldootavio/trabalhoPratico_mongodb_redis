# ==============================================================================
# CONFIGURAÇÃO DE CONEXÃO COM MONGODB ATLAS E REDIS
# CONADS 2026 - Trabalho Prático NoSQL BD2 (IFMG Campus Ouro Preto)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🍃 MONGODB / MONGO ATLAS CONFIGURATION
# ------------------------------------------------------------------------------
# Para conectar ao MongoDB Atlas (Nuvem), cole sua String de Conexão (MONGO_URI) abaixo.
# Exemplo MongoDB Atlas:
# MONGO_URI=mongodb+srv://meu_usuario:minha_senha@cluster0.abcde.mongodb.net/congresso_ads?retryWrites=true&w=majority
#
# Para uso local:
# MONGO_URI=mongodb://127.0.0.1:27017
MONGO_URI=
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB_NAME=congresso_ads

# ------------------------------------------------------------------------------
# ⚡ REDIS CONFIGURATION (Local ou Redis Cloud / Upstash)
# ------------------------------------------------------------------------------
# Para conectar ao Redis Cloud / Upstash via URI:
# REDIS_URI=redis://default:minha_senha_redis@redis-12345.c1.us-east-1-2.ec2.redislabs.com:12345
#
# Ou configure pelos campos individuais:
REDIS_URI=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SCHEME=tcp
